<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Allows the solution (which includes this Windows-only project) to build on the ubuntu CI leg. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AspireApp.Pos</RootNamespace>
    <AssemblyName>AspireApp.Pos</AssemblyName>
  </PropertyGroup>

</Project>