<Window x:Class="AspireApp.Pos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AspireApp.Pos.ViewModels"
        xmlns:local="clr-namespace:AspireApp.Pos"
        xmlns:models="clr-namespace:AspireApp.Pos.Models"
        Title="AspireApp POS — Punto de Venta"
        Height="820" Width="1360"
        MinHeight="660" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:EnumToBooleanConverter x:Key="EnumToBool" />
        <local:CurrencyConverter x:Key="Currency" />
        <local:GreaterThanZeroToVisibilityConverter x:Key="GreaterThanZeroToVisibility" />

        <Style x:Key="PaymentMethodToggle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chip"
                                Background="Transparent"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="14,9">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="#FF10131A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TotalsRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navegación de la terminal -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceAltBrush}"
                CornerRadius="8" Padding="12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Separator Margin="0,10,0,10" />
                    <TextBlock Text="TURNO" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="Cajero 01" FontWeight="SemiBold" />
                    <TextBlock Text="Terminal 01 · Caja abierta" Style="{StaticResource HintText}" Margin="0,2,0,8" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,6">
                        <Run Text="Ventas: " />
                        <Run Text="{Binding Receipts.Count, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,6">
                        <Run Text="Recaudado: " />
                        <Run Text="{Binding ReceiptsTotal, Converter={StaticResource Currency}, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource HintText}">
                        <Run Text="Stock bajo: " />
                        <Run Text="{Binding LowStockCount, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock Text="F1 buscar · F2 cobrar · F4 vaciar" Style="{StaticResource HintText}"
                               TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Mishi y Masha" FontSize="18" FontWeight="Bold" Margin="0,0,0,2" />
                    <TextBlock Text="CAFETERÍA · SUCURSAL CENTRO" Style="{StaticResource HintText}"
                               TextWrapping="Wrap" Margin="0,0,0,14" />

                    <RadioButton Content="Venta" GroupName="TerminalNav"
                                 Style="{StaticResource NavButton}" Margin="0,0,0,6"
                                 IsChecked="{Binding IsSaleView, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Sale" />
                    <RadioButton Content="Historial de ventas" GroupName="TerminalNav"
                                 Style="{StaticResource NavButton}" Margin="0,0,0,6"
                                 IsChecked="{Binding IsHistoryView, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="History" />
                    <RadioButton Content="Inventario" GroupName="TerminalNav"
                                 Style="{StaticResource NavButton}" Margin="0,0,0,6"
                                 IsChecked="{Binding IsInventoryView, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Inventory" />
                    <RadioButton Content="Cierre de caja" GroupName="TerminalNav"
                                 Style="{StaticResource NavButton}"
                                 IsChecked="{Binding IsCashCloseView, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="CashClose" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Contenido -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceAltBrush}"
                    CornerRadius="8" Padding="16,12" Margin="0,0,0,14">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentViewTitle, Mode=OneWay}" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="{Binding CurrentViewSubtitle, Mode=OneWay}" Margin="12,6,0,0"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding StatusMessage}" />
                </Grid>
            </Border>

            <!-- ===================== VENTA ===================== -->
            <Grid Grid.Row="1" Grid.Column="2"
                  Visibility="{Binding IsSaleView, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="0.95*" />
                </Grid.ColumnDefinitions>

            <!-- Catálogo -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceAltBrush}"
                    CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="CATÁLOGO" Style="{StaticResource SectionHeader}" />

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Grid.Column="0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="SearchBox_KeyDown"
                                 ToolTip="Escriba nombre, categoría o SKU y presione Enter" />
                        <TextBlock Grid.Column="0" IsHitTestVisible="False"
                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="#FF6E7488"
                                   Text="Buscar producto o escanear SKU..."
                                   Visibility="{Binding Text, ElementName=SearchBox,
                                                Converter={x:Static local:EmptyTextToVisibilityConverter.Instance}}" />
                        <Button Grid.Column="1" Content="＋" FontSize="18" Width="44"
                                Margin="8,0,0,0" Style="{StaticResource AccentButton}"
                                ToolTip="Agregar el código escrito al ticket (Enter)"
                                Command="{Binding AddByCodeCommand}" />
                    </Grid>

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Categories}"
                             SelectedItem="{Binding SelectedCategoryItem, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource CategoryChip}"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             Margin="0,0,0,12">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>

                    <ListBox Grid.Row="3"
                             ItemsSource="{Binding Products}"
                             SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource TileItemStyle}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="150">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,6">
                                        <Run Text="{Binding Sku, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding Category, Mode=OneWay}" />
                                    </TextBlock>
                                    <Grid>
                                        <TextBlock Text="{Binding Price, Converter={StaticResource Currency}, Mode=OneWay}"
                                                   FontSize="15" FontWeight="Bold" />
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Style="{StaticResource HintText}"
                                                   Text="{Binding StockLabel}" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="4">
                        <TextBlock Text="{Binding ResultsLabel, Mode=OneWay}" Style="{StaticResource HintText}"
                                   VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Content="Agregar al ticket"
                                Padding="12,6" FontSize="12"
                                Command="{Binding AddSelectedProductCommand}" />
                    </Grid>
                </Grid>
        </Border>
                <!-- Ticket -->
                <Border Grid.Column="2" Background="{StaticResource SurfaceAltBrush}"
                        CornerRadius="8" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="TICKET ACTUAL" Style="{StaticResource SectionHeader}" Margin="0" />
                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource HintText}"
                                       Text="{Binding LabelLabel, Mode=OneWay}" />
                        </Grid>

                        <!-- Vista de carrito -->
                        <Grid Grid.Row="1" Visibility="{Binding IsCartOpen, Converter={StaticResource BoolToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DataGrid Grid.Row="0"
                                      ItemsSource="{Binding Cart}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Artículo" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Style="{StaticResource HintText}">
                                                        <Run Text="{Binding UnitPrice, Converter={StaticResource Currency}, Mode=OneWay}" />
                                                        <Run Text=" c/u" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Cant." Width="96"
                                                            CellStyle="{StaticResource CellCenter}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="−" Style="{StaticResource IconButton}"
                                                            Command="{Binding DataContext.DecrementLineCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <TextBlock Text="{Binding Quantity}" Width="28"
                                                               TextAlignment="Center" VerticalAlignment="Center" />
                                                    <Button Content="+" Style="{StaticResource IconButton}"
                                                            Command="{Binding DataContext.IncrementLineCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Desc." Width="80"
                                                            CellStyle="{StaticResource CellRight}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock VerticalAlignment="Center"
                                                           Text="{Binding LineDiscount, Converter={StaticResource Currency}, Mode=OneWay}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding LineDiscount, UpdateSourceTrigger=LostFocus}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Importe" Width="86" IsReadOnly="True"
                                                        CellStyle="{StaticResource CellRight}"
                                                        Binding="{Binding Subtotal, Converter={StaticResource Currency}, Mode=OneWay}" />
                                    <DataGridTemplateColumn Width="34" CellStyle="{StaticResource CellAction}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✕" Style="{StaticResource IconButton}"
                                                        Foreground="{StaticResource DangerBrush}"
                                                        Command="{Binding DataContext.RemoveLineCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Totales -->
                            <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Subtotal" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Style="{StaticResource AmountText}"
                                               Text="{Binding Subtotal, Converter={StaticResource Currency}, Mode=OneWay}" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Descuento del ticket" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Style="{StaticResource AmountText}"
                                               Foreground="{StaticResource WarnBrush}"
                                               Text="{Binding DiscountTotal, Converter={StaticResource Currency}, Mode=OneWay}" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                                    <TextBox Width="70" Margin="0,0,6,0" VerticalContentAlignment="Center"
                                             Text="{Binding CartDiscount, StringFormat=0.00, UpdateSourceTrigger=LostFocus}"
                                             ToolTip="Descuento en pesos" />
                                    <Button Content="− 5" Style="{StaticResource IconButton}" Width="38"
                                            Command="{Binding DecreaseDiscountCommand}" />
                                    <Button Content="+ 5" Style="{StaticResource IconButton}" Width="38" Margin="6,0,0,0"
                                            Command="{Binding IncreaseDiscountCommand}" />
                                </StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Impuesto (IVA)" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Style="{StaticResource AmountText}"
                                               Text="{Binding TaxAmount, Converter={StaticResource Currency}, Mode=OneWay}" />
                                </Grid>
                                <!-- Solo se muestra cuando el ticket mezcla exentos y gravados. -->
                                <Grid Margin="0,0,0,10"
                                      Visibility="{Binding ExemptSubtotal, Converter={StaticResource GreaterThanZeroToVisibility}}">
                                    <TextBlock Text="Base exenta de IVA" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}"
                                               Text="{Binding ExemptSubtotal, Converter={StaticResource Currency}, Mode=OneWay}" />
                                </Grid>
                                <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,10" />
                                <Grid>
                                    <TextBlock Text="TOTAL" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource TotalValue}"
                                               Text="{Binding Total, Converter={StaticResource Currency}, Mode=OneWay}" />
                                </Grid>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="1.6*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Vaciar"
                                            Command="{Binding ClearCartCommand}" />
                                    <Button Grid.Column="2" Content="Cobrar" FontSize="16"
                                            Style="{StaticResource AccentButton}"
                                            Command="{Binding OpenPaymentCommand}" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Vista de cobro -->
                        <Grid Grid.Row="1" Visibility="{Binding IsPaymentOpen, Converter={StaticResource BoolToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                                    CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="TOTAL A COBRAR" Style="{StaticResource SectionHeader}" />
                                    <TextBlock Style="{StaticResource BigValue}"
                                               Text="{Binding Total, Converter={StaticResource Currency}, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                                               Text="{Binding LabelLabel, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                <TextBlock Text="MÉTODO DE PAGO" Style="{StaticResource SectionHeader}" />
                                <WrapPanel>
                                    <RadioButton Content="Efectivo" GroupName="Pay"
                                                 Style="{StaticResource PaymentMethodToggle}"
                                                 IsChecked="{Binding PaymentMethod, Converter={StaticResource EnumToBool},
                                                             ConverterParameter={x:Static models:PaymentMethod.Efectivo}}"
                                                 Command="{Binding SelectPaymentMethodCommand}"
                                                 CommandParameter="{x:Static models:PaymentMethod.Efectivo}" />
                                    <RadioButton Content="Débito" GroupName="Pay"
                                                 Style="{StaticResource PaymentMethodToggle}"
                                                 IsChecked="{Binding PaymentMethod, Converter={StaticResource EnumToBool},
                                                             ConverterParameter={x:Static models:PaymentMethod.TarjetaDebito}}"
                                                 Command="{Binding SelectPaymentMethodCommand}"
                                                 CommandParameter="{x:Static models:PaymentMethod.TarjetaDebito}" />
                                    <RadioButton Content="Crédito" GroupName="Pay"
                                                 Style="{StaticResource PaymentMethodToggle}"
                                                 IsChecked="{Binding PaymentMethod, Converter={StaticResource EnumToBool},
                                                             ConverterParameter={x:Static models:PaymentMethod.TarjetaCredito}}"
                                                 Command="{Binding SelectPaymentMethodCommand}"
                                                 CommandParameter="{x:Static models:PaymentMethod.TarjetaCredito}" />
                                    <RadioButton Content="Transferencia" GroupName="Pay"
                                                 Style="{StaticResource PaymentMethodToggle}"
                                                 IsChecked="{Binding PaymentMethod, Converter={StaticResource EnumToBool},
                                                             ConverterParameter={x:Static models:PaymentMethod.Transferencia}}"
                                                 Command="{Binding SelectPaymentMethodCommand}"
                                                 CommandParameter="{x:Static models:PaymentMethod.Transferencia}" />
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel Grid.Row="2"
                                        Visibility="{Binding CashPanelVisibility}">
                                <Border Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8"
                                        Padding="12,8" Margin="0,0,0,10">
                                    <TextBlock FontSize="26" FontWeight="Bold"
                                               Text="{Binding PaymentEntry, Converter={StaticResource Currency}, Mode=OneWay}" />
                                </Border>

                                <UniformGrid Columns="3" Margin="0,0,0,8">
                                    <Button Content="1" Style="{StaticResource KeypadButton}" Command="{Binding PaymentKeyCommand}" CommandParameter="1" />
                                    <Button Content="2" Style="{StaticResource KeypadButton}" Command="{Binding PaymentKeyCommand}" CommandParameter="2" Margin="6,0,6,0" />
                                    <Button Content="3" Style="{StaticResource KeypadButton}" Command="{Binding PaymentKeyCommand}" CommandParameter="3" />
                                </UniformGrid>
                                <UniformGrid Columns="3" Margin="0,0,0,8">
                                    <Button Content="4" Style="{StaticResource KeypadButton}" Command="{Binding PaymentKeyCommand}" CommandParameter="4" />
                                    <Button Content="5" Style="{StaticResource KeypadButton}" Command="{Binding PaymentKeyCommand}" CommandParameter="5" Margin="6,0,6,0" />
                                    <Button Content="6" Style="{StaticResource KeypadButton}" Command="{Binding PaymentKeyCommand}" CommandParameter="6" />
                                </UniformGrid>
                                <UniformGrid Columns="3" Margin="0,0,0,8">
                                    <Button Content="7" Style="{StaticResource KeypadButton}" Command="{Binding PaymentKeyCommand}" CommandParameter="7" />
                                    <Button Content="8" Style="{StaticResource KeypadButton}" Command="{Binding PaymentKeyCommand}" CommandParameter="8" Margin="6,0,6,0" />
                                    <Button Content="9" Style="{StaticResource KeypadButton}" Command="{Binding PaymentKeyCommand}" CommandParameter="9" />
                                </UniformGrid>
                                <UniformGrid Columns="3" Margin="0,0,0,8">
                                    <Button Content="." Style="{StaticResource KeypadButton}" Command="{Binding PaymentKeyCommand}" CommandParameter="." />
                                    <Button Content="0" Style="{StaticResource KeypadButton}" Command="{Binding PaymentKeyCommand}" CommandParameter="0" Margin="6,0,6,0" />
                                    <Button Content="⌫" Style="{StaticResource KeypadButton}" Command="{Binding PaymentKeyCommand}" CommandParameter="B" />
                                </UniformGrid>
                                <UniformGrid Columns="2">
                                    <Button Content="Exacto" Height="40" Margin="0,0,6,0" Command="{Binding ExactAmountCommand}" />
                                    <Button Content="Limpiar" Height="40" Margin="6,0,0,0" Command="{Binding PaymentKeyCommand}" CommandParameter="C" />
                                </UniformGrid>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                                        Padding="12,10" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="Recibido" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold"
                                                       Text="{Binding PaidAmount, Converter={StaticResource Currency}, Mode=OneWay}" />
                                        </Grid>
                                        <TextBlock Text="{Binding ChangeLabel, Mode=OneWay}" Margin="0,6,0,0"
                                                   FontWeight="Bold" FontSize="16">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPaymentSatisfied, Mode=OneWay}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="1.6*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Cancelar"
                                            Command="{Binding CancelPaymentCommand}" />
                                    <Button Grid.Column="2" Content="Confirmar pago" FontSize="16"
                                            Style="{StaticResource AccentButton}"
                                            Command="{Binding ConfirmPaymentCommand}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Historial de ventas del turno -->
                <Border Grid.Column="4" Background="{StaticResource SurfaceAltBrush}"
                        CornerRadius="8" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="VENTAS DEL TURNO" Style="{StaticResource SectionHeader}" Margin="0" />
                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource HintText}">
                                <Run Text="{Binding Receipts.Count, Mode=OneWay}" />
                                <Run Text=" tickets" />
                            </TextBlock>
                        </Grid>

                        <ListBox Grid.Row="1" ItemsSource="{Binding Receipts}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource TileItemStyle}">
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding Number}" FontSize="12"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock HorizontalAlignment="Right" FontWeight="Bold"
                                                       Text="{Binding AmountLabel, Mode=OneWay}" />
                                        </Grid>
                                        <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0">
                                            <Run Text="{Binding TimeLabel, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding ItemCount, Mode=OneWay}" />
                                            <Run Text=" art. · " />
                                            <Run Text="{Binding Payment.MethodLabel, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="2" Margin="0,12,0,0">
                            <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,10" />
                            <Grid>
                                <TextBlock Text="Recaudado en el turno" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock HorizontalAlignment="Right" FontWeight="Bold"
                                           Text="{Binding ReceiptsTotal, Converter={StaticResource Currency}, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,10,0,0">

                    <TextBlock FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                               Text="F1 buscar · F2 cobrar · F4 vaciar ticket" />
                </StackPanel>
            </Grid>

            <!-- ===================== HISTORIAL ===================== -->
            <Grid Grid.Row="1" Visibility="{Binding IsHistoryView, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource SurfaceAltBrush}"
                        CornerRadius="8" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="TICKETS DEL TURNO" Style="{StaticResource SectionHeader}" Margin="0" />
                                <TextBlock HorizontalAlignment="Right" Style="{StaticResource HintText}"
                                           Text="{Binding LabelLabel, Mode=OneWay}" />
                            </Grid>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Receipts}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  SelectedItem="{Binding SelectedReceipt, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ticket" Width="170" ElementStyle="{StaticResource GridCellText}" Binding="{Binding Number, Mode=OneWay}" />
                                <DataGridTextColumn Header="Hora" Width="90" ElementStyle="{StaticResource GridCellText}" Binding="{Binding TimeLabel, Mode=OneWay}" />
                                <DataGridTextColumn Header="Cajero" Width="110" ElementStyle="{StaticResource GridCellText}" Binding="{Binding Cashier, Mode=OneWay}" />
                                <DataGridTextColumn Header="Pago" Width="130" ElementStyle="{StaticResource GridCellText}" Binding="{Binding Payment.MethodLabel, Mode=OneWay}" />
                                <DataGridTextColumn Header="Artículos" Width="90" ElementStyle="{StaticResource GridCellText}"
                                                    Binding="{Binding ItemCount, Mode=OneWay}" />
                                <DataGridTextColumn Header="Total" Width="*" ElementStyle="{StaticResource GridCellText}"
                                                    Binding="{Binding TotalLabel, Mode=OneWay}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Detalle del ticket seleccionado -->
                <Border Grid.Column="2" Background="{StaticResource SurfaceAltBrush}"
                        CornerRadius="8" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="DETALLE DEL TICKET" Style="{StaticResource SectionHeader}" />

                        <ListBox Grid.Row="1" ItemsSource="{Binding SelectedReceipt.Lines}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource HintText}">
                                                <Run Text="{Binding Quantity}" />
                                                <Run Text=" × " />
                                                <Run Text="{Binding UnitPrice, Converter={StaticResource Currency}, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold"
                                                   Text="{Binding Subtotal, Converter={StaticResource Currency}, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="2" Margin="0,12,0,0">
                            <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,10" />
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Subtotal" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock HorizontalAlignment="Right"
                                           Text="{Binding SelectedReceipt.Payment.Subtotal, Converter={StaticResource Currency}, Mode=OneWay}" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Descuento" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource WarnBrush}"
                                           Text="{Binding SelectedReceipt.Payment.Discount, Converter={StaticResource Currency}, Mode=OneWay}" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Impuesto" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock HorizontalAlignment="Right"
                                           Text="{Binding SelectedReceipt.Payment.Tax, Converter={StaticResource Currency}, Mode=OneWay}" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Recibido" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock HorizontalAlignment="Right"
                                           Text="{Binding SelectedReceipt.Payment.AmountPaid, Converter={StaticResource Currency}, Mode=OneWay}" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Cambio" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock HorizontalAlignment="Right"
                                           Text="{Binding SelectedReceipt.Payment.Change, Converter={StaticResource Currency}, Mode=OneWay}" />
                            </Grid>
                            <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,10" />
                            <Grid>
                                <TextBlock Text="TOTAL" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource TotalValue}"
                                           Text="{Binding SelectedReceipt.TotalLabel, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===================== INVENTARIO ===================== -->
            <Grid Grid.Row="1" Visibility="{Binding IsInventoryView, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource SurfaceAltBrush}"
                        CornerRadius="8" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="EXISTENCIAS" Style="{StaticResource SectionHeader}" />

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Inventory}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SKU" Width="90" ElementStyle="{StaticResource GridCellText}" Binding="{Binding Sku, Mode=OneWay}" />
                                <DataGridTextColumn Header="Producto" Width="*" ElementStyle="{StaticResource GridCellText}" Binding="{Binding Name, Mode=OneWay}" />
                                <DataGridTextColumn Header="Categoría" Width="110" ElementStyle="{StaticResource GridCellText}" Binding="{Binding Category, Mode=OneWay}" />
                                <DataGridTextColumn Header="Precio" Width="100" ElementStyle="{StaticResource GridCellText}"
                                                    Binding="{Binding Price, Converter={StaticResource Currency}, Mode=OneWay}" />
                                <DataGridTextColumn Header="Stock" Width="70" ElementStyle="{StaticResource GridCellText}" Binding="{Binding Stock, Mode=OneWay}" />
                                <DataGridTextColumn Header="Estado" Width="90" ElementStyle="{StaticResource GridCellText}" Binding="{Binding StockLabel, Mode=OneWay}" />
                                <DataGridTemplateColumn Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="+ Reponer" Padding="8,4" FontSize="11"
                                                    Command="{Binding DataContext.AdjustStockCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8"
                            Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="RESUMEN" Style="{StaticResource SectionHeader}" />
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Unidades en existencia" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold"
                                           Text="{Binding TotalUnits, Mode=OneWay}" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Valor del inventario" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold"
                                           Text="{Binding InventoryValue, Converter={StaticResource Currency}, Mode=OneWay}" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Productos agotados" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold"
                                           Foreground="{StaticResource DangerBrush}"
                                           Text="{Binding OutOfStockCount, Mode=OneWay}" />
                            </Grid>
                            <TextBlock Text="{Binding InventorySummary, Mode=OneWay}" Style="{StaticResource HintText}"
                                       TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="ALERTAS DE REPOSICIÓN" Style="{StaticResource SectionHeader}" />
                            <ListBox Grid.Row="1" ItemsSource="{Binding LowStockItems}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Margin="8,0,0,0"
                                                       Style="{StaticResource HintText}"
                                                       Text="{Binding StockLabel, Mode=OneWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ===================== CIERRE DE CAJA ===================== -->
            <Grid Grid.Row="1" Visibility="{Binding IsCashCloseView, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource SurfaceAltBrush}"
                        CornerRadius="8" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="RESUMEN DEL TURNO" Style="{StaticResource SectionHeader}" />

                        <UniformGrid Grid.Row="1" Rows="2" Columns="2" Margin="0,0,0,14">
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                                    Padding="14" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="TICKETS" Style="{StaticResource SectionHeader}" />
                                    <TextBlock Style="{StaticResource BigValue}" Text="{Binding TicketCount, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                                    Padding="14" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="TOTAL RECAUDADO" Style="{StaticResource SectionHeader}" />
                                    <TextBlock Style="{StaticResource BigValue}"
                                               Text="{Binding TicketsTotal, Converter={StaticResource Currency}, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                                    Padding="14" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="TICKET PROMEDIO" Style="{StaticResource SectionHeader}" />
                                    <TextBlock Style="{StaticResource BigValue}"
                                               Text="{Binding AverageTicket, Converter={StaticResource Currency}, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="ARTÍCULOS VENDIDOS" Style="{StaticResource SectionHeader}" />
                                    <TextBlock Style="{StaticResource BigValue}" Text="{Binding ItemSoldTotal, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="DESGLOSE POR MÉTODO DE PAGO" Style="{StaticResource SectionHeader}" />
                                <DataGrid Grid.Row="1" ItemsSource="{Binding PaymentBreakdown}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Método" Width="*" ElementStyle="{StaticResource GridCellText}" Binding="{Binding Method, Mode=OneWay}" />
                                        <DataGridTextColumn Header="Tickets" Width="100" ElementStyle="{StaticResource GridCellText}" Binding="{Binding TicketsLabel, Mode=OneWay}" />
                                        <DataGridTextColumn Header="Participación" Width="120" ElementStyle="{StaticResource GridCellText}" Binding="{Binding ShareLabel, Mode=OneWay}" />
                                        <DataGridTextColumn Header="Importe" Width="140" ElementStyle="{StaticResource GridCellText}"
                                                            Binding="{Binding AmountLabel, Mode=OneWay}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8"
                            Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="ARQUEO DE CAJA" Style="{StaticResource SectionHeader}" />
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Fondo inicial" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold"
                                           Text="{Binding OpeningFloat, Converter={StaticResource Currency}, Mode=OneWay}" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Ventas en efectivo" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold"
                                           Text="{Binding CashTotal, Converter={StaticResource Currency}, Mode=OneWay}" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Tarjeta" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold"
                                           Text="{Binding CardTotal, Converter={StaticResource Currency}, Mode=OneWay}" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Transferencia" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold"
                                           Text="{Binding TransferTotal, Converter={StaticResource Currency}, Mode=OneWay}" />
                            </Grid>
                            <Separator Background="{StaticResource BorderBrush}" Margin="0,10,0,10" />
                            <TextBlock Text="EFECTIVO ESPERADO EN CAJÓN" Style="{StaticResource SectionHeader}" />
                            <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="26" FontWeight="Bold"
                                       Text="{Binding ExpectedCash, Converter={StaticResource Currency}, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8"
                            Padding="14">
                        <StackPanel>
                            <TextBlock Text="NOTA" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="{Binding CashCloseSummary, Mode=OneWay}"
                                       Style="{StaticResource HintText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

        </Grid>
    </Grid>
</Window>
