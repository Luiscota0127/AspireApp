@page "/weather"
@attribute [StreamRendering(true)]
@attribute [OutputCache(Duration = 5)]
@inject WeatherApiClient WeatherApi

<PageTitle>Clima</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Ejemplo</p>
        <h1 class="page-header__title">Clima</h1>
        <p class="page-header__subtitle">Datos servidos por el servicio de API del backend.</p>
    </div>
</div>

<div class="panel">
    @if (forecasts == null)
    {
        <div class="empty-state">
            <p class="mb-0">Cargando pronóstico…</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th aria-label="Temperatura en Celsius">Temp. (C)</th>
                        <th aria-label="Temperatura en Fahrenheit">Temp. (F)</th>
                        <th>Resumen</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var forecast in forecasts)
                    {
                        <tr>
                            <td>@forecast.Date.ToShortDateString()</td>
                            <td><span class="temp-pill">@forecast.TemperatureC °C</span></td>
                            <td class="text-muted">@forecast.TemperatureF °F</td>
                            <td>@forecast.Summary</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    .temp-pill {
        display: inline-block;
        padding: 0.2rem 0.55rem;
        border-radius: var(--radius-pill);
        background: var(--brand-50);
        color: var(--brand-700);
        font-size: 0.8125rem;
        font-weight: 650;
    }
</style>

@code {
    private WeatherForecast[]? forecasts;

    protected override async Task OnInitializedAsync()
    {
        forecasts = await WeatherApi.GetWeatherAsync();
    }
}
