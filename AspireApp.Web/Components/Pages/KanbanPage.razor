@page "/kanban"
@using AspireApp.Web.Services
@inject ApiAuthService Api

<PageTitle>Kanban</PageTitle>

@* Project picker for the board. Once one is chosen the board renders below with
   its own header, so this page only owns the selection and empty/error states. *@
@if (isLoading)
{
    <div class="empty-state">
        <p>Cargando proyectos…</p>
    </div>
}
else if (loadError != null)
{
    <div class="alert alert-warning d-flex align-items-center gap-2" role="alert">
        <span>@loadError</span>
        <button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="LoadProjectsAsync">Reintentar</button>
    </div>
}
else if (projects == null || projects.Length == 0)
{
    <div class="alert alert-info" role="alert">
        No hay proyectos todavía. Crea uno desde el <a href="/dashboard">Dashboard</a> para empezar a usar el tablero.
    </div>
}
else
{
    @if (selectedProjectId == Guid.Empty)
    {
        <div class="page-header">
            <div>
                <p class="eyebrow">Tableros</p>
                <h1 class="page-header__title">Kanban</h1>
                <p class="page-header__subtitle">Escoge un proyecto para abrir su tablero.</p>
            </div>
        </div>
    }

    <div class="kanban-picker">
        <label for="project-picker">Proyecto</label>
        <select id="project-picker" class="form-select"
                value="@selectedProjectId" @onchange="OnProjectChange">
            <option value="">— Selecciona un proyecto —</option>
            @foreach (var p in projects)
            {
                <option value="@p.Id">@p.Name</option>
            }
        </select>
    </div>

    @if (selectedProjectId != Guid.Empty)
    {
        @* The leading @ is required, otherwise the parameter receives the literal
           text "SelectedProjectName" instead of the resolved property value. *@
        <Kanban @key="selectedProjectId" ProjectId="selectedProjectId" ProjectName="@SelectedProjectName" />
    }
}

<style>
    .kanban-picker {
        max-width: 26rem;
        margin-bottom: 1.5rem;
    }

    .kanban-picker label {
        display: block;
    }
</style>

@code {
    private ApiAuthService.ProjectDto[]? projects;
    private Guid selectedProjectId = Guid.Empty;
    private bool isLoading;
    private string? loadError;

    /// <summary>Board title and the prefix of each card key.</summary>
    private string? SelectedProjectName
        => projects?.FirstOrDefault(p => p.Id == selectedProjectId)?.Name;

    protected override async Task OnInitializedAsync()
    {
        await LoadProjectsAsync();
    }

    private async Task LoadProjectsAsync()
    {
        isLoading = true;
        loadError = null;
        try
        {
            var result = await Api.GetProjectsAsync();
            if (result == null)
            {
                projects = null;
                loadError = "No se pudieron cargar los proyectos. Revisa que la API esté disponible y que tengas sesión iniciada.";
                return;
            }

            projects = result;
            // keep the selection only if that project still exists
            if (selectedProjectId != Guid.Empty && result.All(p => p.Id != selectedProjectId))
            {
                selectedProjectId = Guid.Empty;
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnProjectChange(ChangeEventArgs e)
    {
        selectedProjectId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : Guid.Empty;
    }
}
