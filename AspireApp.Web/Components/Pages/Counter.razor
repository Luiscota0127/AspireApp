@page "/counter"
@rendermode InteractiveServer

<PageTitle>Contador</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Ejemplo</p>
        <h1 class="page-header__title">Contador</h1>
        <p class="page-header__subtitle">Un componente interactivo mínimo para probar el circuito de Blazor.</p>
    </div>
</div>

<div class="panel counter-panel">
    <span class="stat__label">Valor actual</span>
    <strong class="counter-value" role="status" aria-live="polite">@currentCount</strong>
    <button class="btn btn-primary" @onclick="IncrementCount">Sumar 1</button>
</div>

<style>
    .counter-panel {
        max-width: 22rem;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
    }

    .counter-value {
        font-size: 2.75rem;
        font-weight: 650;
        letter-spacing: -0.04em;
        line-height: 1;
        color: var(--brand-600);
    }
</style>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
