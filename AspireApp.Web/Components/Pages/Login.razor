@page "/login"
@using System.ComponentModel.DataAnnotations
@inject AspireApp.Web.Services.ApiAuthService AuthService
@inject NavigationManager Nav

<PageTitle>Iniciar sesión</PageTitle>

<div class="login-container">
    <div class="login-brand">
        <span class="login-brand__mark" aria-hidden="true">A</span>
        <div>
            <h3>Iniciar sesión</h3>
            <p class="text-muted mb-0" style="font-size:0.8125rem;">Accede a tus proyectos y tableros</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }

    <EditForm Model="model" @formname="Login" OnValidSubmit="HandleLogin">
        <DataAnnotationsValidator />
        <ValidationSummary class="validation-errors" />

        <div class="form-group mb-3">
            <label for="email">Email</label>
            <InputText id="email"
                       type="email"
                       class="form-control"
                       @bind-Value="model.Email"
                       placeholder="tu@empresa.com" />
            <ValidationMessage For="() => model.Email" class="validation-message" />
        </div>

        <div class="form-group mb-3">
            <label for="password">Contraseña</label>
            <InputText id="password"
                       type="password"
                       class="form-control"
                       @bind-Value="model.Password"
                       placeholder="••" />
            <ValidationMessage For="() => model.Password" class="validation-message" />
        </div>

        <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
            @if (isSubmitting)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                <span>Entrando…</span>
            }
            else
            {
                <span>Entrar</span>
            }
        </button>
    </EditForm>
</div>

@code {
    [SupplyParameterFromForm(FormName = "Login")]
    public LoginModel model { get; set; } = new();

    /// <summary>Where to go after signing in; set by RedirectToLogin.</summary>
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private string? errorMessage;
    private bool isSubmitting;

    private async Task HandleLogin()
    {
        isSubmitting = true;
        errorMessage = null;
        try
        {
            var ok = await AuthService.LoginAsync(model.Email, model.Password);
            if (ok)
            {
                // only honour a local path, so a crafted returnUrl cannot send us off-site
                var target = "/dashboard";
                if (!string.IsNullOrWhiteSpace(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//"))
                {
                    target = ReturnUrl;
                }

                Nav.NavigateTo(target);
            }
            else
            {
                errorMessage = "Email o contraseña incorrectos. Inténtalo de nuevo.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Ha ocurrido un error inesperado al iniciar sesión.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    public class LoginModel
    {
        [Required(ErrorMessage = "El email es obligatorio.")]
        [EmailAddress(ErrorMessage = "El formato del email no es válido.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "La contraseña es obligatoria.")]
        [MinLength(6, ErrorMessage = "La contraseña debe tener al menos 6 caracteres.")]
        public string Password { get; set; } = string.Empty;
    }
}
