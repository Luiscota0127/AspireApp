@page "/projects/{ProjectId:guid}/members"
@inject AspireApp.Web.Services.ApiAuthService Api
@inject NavigationManager Nav
@inject AspireApp.Web.Services.CollaborationService Collab
@implements IAsyncDisposable

<PageTitle>Miembros del proyecto</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Proyecto</p>
        <h1 class="page-header__title">Miembros</h1>
        <p class="page-header__subtitle">Quién tiene acceso a este proyecto y con qué rol.</p>
    </div>
    <div class="page-header__actions">
        <a class="btn btn-outline-secondary btn-sm" href="/dashboard">Volver al dashboard</a>
    </div>
</div>

<div class="panel">
    <h2 class="panel__title">Añadir miembro</h2>
    <EditForm Model="newMember" OnValidSubmit="Add">
        <div class="member-add">
            <div class="member-add__field">
                <label for="member-email">Email</label>
                <InputText id="member-email" class="form-control" @bind-Value="newMember.Email" placeholder="persona@empresa.com" />
            </div>
            <div class="member-add__field">
                <label for="member-role">Rol (opcional)</label>
                <InputText id="member-role" class="form-control" @bind-Value="newMember.Role" placeholder="Editor" />
            </div>
            <button type="submit" class="btn btn-primary">Añadir</button>
        </div>
    </EditForm>
</div>

<h2 class="section-head__title" style="margin-top:1.75rem;">Equipo</h2>

@if (members == null)
{
    <div class="empty-state">
        <p>Cargando miembros…</p>
    </div>
}
else if (members.Length == 0)
{
    <div class="empty-state">
        <span class="empty-state__icon" aria-hidden="true">☺</span>
        <p class="mb-0">Todavía no hay miembros en este proyecto.</p>
    </div>
}
else
{
    <div class="member-list">
        @foreach (var m in members)
        {
            <div class="member-row">
                <span class="member-row__avatar" aria-hidden="true">@Mark(m.Email)</span>
                <span class="member-row__info">
                    <strong>@m.Email</strong>
                    <span class="member-row__role">@(string.IsNullOrWhiteSpace(m.Role) ? "Miembro" : m.Role)</span>
                </span>
                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => Remove(m.Id)">Quitar</button>
            </div>
        }
    </div>
}

<style>
    .member-add {
        display: flex;
        gap: 0.75rem;
        align-items: flex-end;
        flex-wrap: wrap;
    }

    .member-add__field {
        flex: 1 1 14rem;
        display: flex;
        flex-direction: column;
    }

    .member-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .member-row {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        padding: 0.75rem 1rem;
        background: var(--surface);
        border: 1px solid var(--ink-200);
        border-radius: var(--radius);
        box-shadow: var(--shadow-xs);
    }

    .member-row__avatar {
        width: 36px;
        height: 36px;
        flex-shrink: 0;
        border-radius: var(--radius-pill);
        background: var(--brand-50);
        color: var(--brand-700);
        display: grid;
        place-items: center;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .member-row__info {
        display: flex;
        flex-direction: column;
        min-width: 0;
        flex: 1;
        line-height: 1.3;
    }

    .member-row__info strong {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--ink-900);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .member-row__role {
        font-size: 0.75rem;
        color: var(--ink-500);
    }

    @@media (max-width: 575.98px) {
        .member-add__field,
        .member-add button {
            flex: 1 1 100%;
        }
    }
</style>

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    private AspireApp.Web.Services.ApiAuthService.ProjectMemberDto[]? members;
    private NewMemberModel newMember = new();

    /// <summary>Monogram for the member avatar, derived from the email local part.</summary>
    private static string Mark(string? email)
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            return "··";
        }

        var parts = email.Split('@')[0].Split(new[] { '.', '_', '-' }, StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[1][0]}"
            : email[..Math.Min(2, email.Length)];
    }

    protected override async Task OnInitializedAsync()
    {
        members = await Api.GetProjectMembersAsync(ProjectId);
        // subscribe to project-specific SignalR group and listen for member changes
        await Collab.SubscribeProjectAsync(ProjectId);
        Collab.OnProjectMemberAdded += OnProjectMemberAdded;
    }

    private async Task Add()
    {
        var ok = await Api.AddProjectMemberAsync(ProjectId, newMember.Email, newMember.Role);
        if (ok) members = await Api.GetProjectMembersAsync(ProjectId);
    }

    private async Task Remove(Guid memberId)
    {
        var ok = await Api.RemoveProjectMemberAsync(ProjectId, memberId);
        if (ok) members = await Api.GetProjectMembersAsync(ProjectId);
    }

    private class NewMemberModel { public string Email { get; set; } = string.Empty; public string? Role { get; set; } }

    private async Task OnProjectMemberAdded(Guid projectId, string? userId, string? role)
    {
        if (projectId != ProjectId) return;
        members = await Api.GetProjectMembersAsync(ProjectId);
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            Collab.OnProjectMemberAdded -= OnProjectMemberAdded;
            await Collab.UnsubscribeProjectAsync(ProjectId);
        }
        catch
        {
            // ignore disposal errors
        }
    }
}
