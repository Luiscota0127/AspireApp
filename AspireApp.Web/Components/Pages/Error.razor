@page "/Error"
@using System.Diagnostics
<PageTitle>Error</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Ups</p>
        <h1 class="page-header__title text-danger">Se ha producido un error</h1>
        <p class="page-header__subtitle">La petición no se pudo completar. Vuelve a intentarlo en unos segundos.</p>
    </div>
</div>

@if (ShowRequestId)
{
    <div class="panel mb-3">
        <span class="stat__label">Request ID</span>
        <p class="mb-0"><code>@RequestId</code></p>
    </div>
}

<div class="panel">
    <h2 class="panel__title">Modo desarrollo</h2>
    <p class="mb-2">
        Cambiar a <strong>Development</strong> mostrará información más detallada sobre el error.
    </p>
    <p class="mb-0 text-muted" style="font-size:0.8125rem;">
        <strong>El entorno de desarrollo no debería estar habilitado en aplicaciones desplegadas</strong>:
        puede exponer información sensible de las excepciones a los usuarios finales. Para depurar en local,
        define la variable de entorno <strong>ASPNETCORE_ENVIRONMENT</strong> como <strong>Development</strong>
        y reinicia la aplicación.
    </p>
</div>

@code {
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    [PersistentState]
    public string? RequestId { get; set; }

    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized()
    {
        RequestId ??= Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
    }
}
